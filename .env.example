# Configuration de l'API Rodium AI (variables obligatoires)
RODIUM_API_KEY=your_rodium_api_key_here
RODIUM_MODEL=anthropic/claude-haiku-4-5-20251001

# Configuration optionnelle
RODIUM_BASE_URL=https://api.rodiumai.io/v1
MAX_TOKENS=600
TEMPERATURE=0

# Évaluation qualité par juge LLM (défaut : off)
# JUDGE=on
